# UniSynapse environment template
# Copy to .env for local development. Never commit .env or real credentials.
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
UNISYNAPSE_DATA_DIR=./data
ALLOW_SQLITE=1
COOKIE_SECURE=0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production must use PostgreSQL and ALLOW_SQLITE=0.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/unisynapse
DATABASE_URL=

SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_SESSION_SECRET=replace-with-a-different-long-random-secret
# Admin Security Key (Bảo mật riêng cho Cổng Quản Trị - Không chia sẻ ra client)
ADMIN_SECURITY_KEY=wit-admin-sec-replace-with-your-strong-random-key
ADMIN_ACCESS_KEY=wit-admin-sec-replace-with-your-strong-random-key
GEMINI_API_KEY=

# Keep mock integrations disabled outside isolated local/test runs.
MOCK_MODE=0
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
SOLANA_PROGRAM_ID=
SOLANA_SIGNER_SECRET_KEY=
