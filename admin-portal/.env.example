# UniSynapse / WIT Standalone Admin Portal Configuration
# KHÔNG ĐƯỢC ĐƯA FILE NÀY LÊN MÁY KHÁCH HOẶC REPO CLIENT CÔNG KHAI

# URL Backend API (FastAPI)
BACKEND_API_URL=http://localhost:8000/api/v1

# Khóa bảo mật quản trị viên độc quyền (Phải khớp với ADMIN_SECURITY_KEY trong backend/.env)
ADMIN_SECURITY_KEY=wit-admin-sec-9a8f4c2e1b7d5e3f01829475c8b6a12d

# Cổng khởi chạy cổng quản trị nội bộ
ADMIN_PORTAL_PORT=8088
